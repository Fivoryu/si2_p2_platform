# Copiar a .env.aws en el servidor EC2 y completar valores.
# Uso: docker compose -f docker-compose.yml -f docker-compose.aws.yml --env-file .env.aws up -d --build

# IP pública o Elastic IP de la instancia EC2 (sin http://)
PUBLIC_HOST=32.196.207.97

# Opcional: Flutter web local (Chrome) contra este backend AWS
# CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1):\d+

# Generar: openssl rand -hex 32
JWT_SECRET=change-me-min-32-characters-long-secret

# Mismo valor en backend y AcquireMock
ACQUIREMOCK_WEBHOOK_SECRET=am-prod-secret-min-32-chars-change-me

# AWS S3 real (credenciales vía IAM instance profile; dejar vacío)
AWS_REGION=us-east-1
S3_BUCKET_EVIDENCIAS=emergencias-evidencias

# Email (opcional)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_SENDER_EMAIL=app@example.com
