{
  "info": {
    "name": "SI2 Ciclo 1 — Usuarios y vehículos",
    "description": "Verificación Ciclo 1 contra backend local (docker compose). Password demo: password123",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" }
  ],
  "item": [
    {
      "name": "Ciclo 1",
      "item": [
        {
          "name": "00 Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Health OK', () => pm.response.to.have.status(200));",
                  "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "CU-01 Login Conductor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{conductorEmail}}\",\n  \"password\": \"{{password}}\",\n  \"tenant_id\": \"{{tenantId}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Rol CONDUCTOR', () => pm.expect(j.rol).to.eql('CONDUCTOR'));",
                  "pm.environment.set('conductorToken', j.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "CU-01 Login Taller",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{tallerEmail}}\",\n  \"password\": \"{{password}}\",\n  \"tenant_id\": \"{{tenantId}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('tallerToken', pm.response.json().access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "CU-01 Login Admin Tenant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adtEmail}}\",\n  \"password\": \"{{password}}\",\n  \"tenant_id\": \"{{tenantId}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('adtToken', pm.response.json().access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "CU-04 Register Conductor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Test Postman\",\n  \"email\": \"{{newUserEmail}}\",\n  \"telefono\": \"70001111\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Register 201', () => pm.response.to.have.status(201));",
                  "pm.test('Has id', () => pm.expect(pm.response.json().id).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const email = 'test' + Date.now() + '@mail.com';",
                  "pm.environment.set('newUserEmail', email);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "CU-04 Login Nuevo Usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"{{password}}\",\n  \"tenant_id\": \"{{publicTenantId}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "CU-05 Crear Vehículo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{conductorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"PM{{$randomInt}}\",\n  \"marca\": \"Toyota\",\n  \"modelo\": \"Yaris\",\n  \"anio\": 2020\n}"
            },
            "url": "{{baseUrl}}/vehiculos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Create 201', () => pm.response.to.have.status(201));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "CU-05 Listar Vehículos",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{conductorToken}}" }
            ],
            "url": "{{baseUrl}}/vehiculos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('List 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has items', () => pm.expect(pm.response.json().items.length).to.be.above(0));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "CU-06 Actualizar Perfil",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{conductorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telefono\": \"79998888\"\n}"
            },
            "url": "{{baseUrl}}/usuarios/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Patch 200', () => pm.response.to.have.status(200));",
                  "pm.test('Telefono actualizado', () => pm.expect(pm.response.json().telefono).to.eql('79998888'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "CU-06 Obtener Perfil",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{conductorToken}}" }
            ],
            "url": "{{baseUrl}}/usuarios/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Get 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "CU-03 Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newUserEmail}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/forgot-password"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Accepted 202', () => pm.response.to.have.status(202));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "CU-07 Crear Taller",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Taller Postman\",\n  \"email\": \"taller{{$timestamp}}@auxilionorte.com\",\n  \"direccion\": \"Test 123\",\n  \"latitud\": -17.78,\n  \"longitud\": -63.18,\n  \"capacidad_max\": 4\n}"
            },
            "url": "{{baseUrl}}/talleres"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Create 201', () => pm.response.to.have.status(201));",
                  "pm.environment.set('newTallerId', pm.response.json().id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "CU-08 Crear Técnico",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"taller_id\": \"{{newTallerId}}\",\n  \"nombre\": \"Tecnico Postman\",\n  \"telefono\": \"7{{$randomInt}}\",\n  \"especialidad\": \"General\"\n}"
            },
            "url": "{{baseUrl}}/tecnicos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Create 201', () => pm.response.to.have.status(201));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "CU-09 Disponibilidad OFF",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tallerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"disponible\": false,\n  \"capacidad_max\": 4\n}"
            },
            "url": "{{baseUrl}}/talleres/{{tallerId}}/disponibilidad"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Patch 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "CU-09 Disponibilidad ON",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tallerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"disponible\": true,\n  \"capacidad_max\": 5\n}"
            },
            "url": "{{baseUrl}}/talleres/{{tallerId}}/disponibilidad"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Patch 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "CU-02 Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{conductorToken}}" }
            ],
            "url": "{{baseUrl}}/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Logout 204', () => pm.response.to.have.status(204));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
